---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('issues');
const sortedPosts = posts.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());
---

<Layout title="Issues | Saudade Magazine">
  <main class="content-list">
    <h1 class="page-title">All Issues</h1>
    <div class="posts-grid">
      {sortedPosts.map((post) => <PostCard post={post} />)}
    </div>
  </main>
</Layout>
