---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('issues');
  const uniqueIssues = [...new Set(allPosts.map(post => post.slug.split('/')[0]))];

  return uniqueIssues.map(issueId => {
    const issueArticles = allPosts
      .filter(post => post.slug.startsWith(issueId + '/'))
      .sort((a, b) => a.slug.localeCompare(b.slug));

    return {
      params: { slug: issueId },
      props: { issueId, articles: issueArticles },
    };
  });
}

const { issueId, articles } = Astro.props;

// 1. EXTRACT GLOBAL CSS (From the first article in the issue)
// If the first article has 'issueGlobalCSS', we apply it to the whole page.
const firstArticle = articles[0];
const globalCSS = firstArticle?.data.issueGlobalCSS || "";

// 2. PREPARE ARTICLE CSS
// We combine all customCSS from all articles into one style block
const allCustomCSS = articles.map(a => a.data.customCSS || "").join("\n");
---

<Layout title={`Issue ${issueId} | Saudade Magazine`}>

  <style set:html={globalCSS + "\n" + allCustomCSS}></style>

  <div id="raw-source" style="display: none;">
    <div id="meta-title" data-title={issueId}></div>

    {articles.map(async (article) => {
      const { Content } = await article.render();
      // We pass the 'customClass' as a data attribute so JS can read it
      return (
        <div class="chapter-stream" data-custom-class={article.data.customClass || ""}>
          <Content />
          <hr class="chapter-break" />
        </div>
      );
    })}
  </div>

  <div class="book-viewport">
    <div id="book" class="flip-book"></div>
    <div id="loader" class="loader">Formatting Issue...</div>
  </div>

</Layout>

<script>
  import { PageFlip } from 'page-flip';

  let bookInstance = null;
  let resizeTimer;
  const CONFIG = { minFontSize: 16, maxFontSize: 20, multiColumnThreshold: 500 };

  document.addEventListener('DOMContentLoaded', initBook);
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      if (bookInstance) {
        bookInstance.destroy();
        document.getElementById('book').innerHTML = '';
        initBook();
      }
    }, 600);
  });

  function initBook() {
    const source = document.getElementById('raw-source');
    const bookEl = document.getElementById('book');
    const loader = document.getElementById('loader');
    loader.style.display = 'block';

    const winW = window.innerWidth;
    const winH = window.innerHeight;
    const isLandscape = winW > winH;
    const bookWidth = isLandscape ? Math.min(winW * 0.9, 1400) : winW * 0.95;
    const bookHeight = winH * 0.85;
    const pageWidth = isLandscape ? bookWidth / 2 : bookWidth;
    const pageHeight = bookHeight;
    const useMultiColumn = pageWidth > CONFIG.multiColumnThreshold;

    // --- TYPESETTING ENGINE UPDATES ---

    // 1. Tag Nodes with their Article Class
    // We flatten the nodes but attach the "parent class" to each node so we track it
    const streamNodes = [];
    source.querySelectorAll('.chapter-stream').forEach(chapter => {
      const articleClass = chapter.getAttribute('data-custom-class');

      Array.from(chapter.children).forEach(child => {
        // Clone the node
        const clone = child.cloneNode(true);
        // Attach the class to the node object itself (as a property) for tracking
        (clone as any)._articleClass = articleClass;
        streamNodes.push(clone);
      });
    });

    // Helper: Create Page with Dynamic Class
    function createPage(isHard = false, extraClass = "") {
      const page = document.createElement('div');

      // HERE IS THE MAGIC:
      // We add the 'extraClass' (the article's custom class) to the page div.
      // This allows CSS like ".my-class .page-content { ... }" to work.
      page.className = isHard ? 'page hard' : `page ${extraClass}`;

      page.style.width = `${pageWidth}px`;
      page.style.height = `${pageHeight}px`;

      const content = document.createElement('div');
      content.className = 'page-content';
      if (useMultiColumn && !isHard) content.classList.add('multi-col');

      page.appendChild(content);
      return { page, content };
    }

    // Cover
    const title = document.getElementById('meta-title').getAttribute('data-title');
    const cover = createPage(true);
    cover.content.innerHTML = `<div class="cover-design"><h1>${title.replace(/-/g, ' ').toUpperCase()}</h1></div>`;
    bookEl.appendChild(cover.page);

    // Content Loop
    // We need to track which article class belongs to the current page
    let currentArticleClass = streamNodes[0]?._articleClass || "";
    let currPage = createPage(false, currentArticleClass);

    bookEl.appendChild(currPage.page);
    const safeHeight = pageHeight - 80;

    for (let i = 0; i < streamNodes.length; i++) {
      const node = streamNodes[i];
      const isHR = node.tagName === 'HR';

      // Check if we switched articles (the node has a different class than the page)
      const nodeClass = (node as any)._articleClass || "";

      // If the new node belongs to a different article, force a page turn
      // to ensure the new page gets the new class
      if (nodeClass !== currentArticleClass && !isHR) {
         currentArticleClass = nodeClass;
         // Finish old page
         currPage = createPage(false, currentArticleClass);
         bookEl.appendChild(currPage.page);
      }

      if (isHR) {
        if (currPage.content.children.length > 0) {
           currPage = createPage(false, currentArticleClass);
           bookEl.appendChild(currPage.page);
        }
        continue;
      }

      currPage.content.appendChild(node);

      // Overflow Check
      let hasOverflow = false;
      if (useMultiColumn) {
        if (currPage.content.scrollWidth > currPage.content.clientWidth + 10) hasOverflow = true;
      } else {
        if (currPage.content.scrollHeight > safeHeight) hasOverflow = true;
      }

      if (hasOverflow) {
        currPage.content.removeChild(node);
        currPage = createPage(false, currentArticleClass);
        bookEl.appendChild(currPage.page);
        currPage.content.appendChild(node);
      }
    }

    const back = createPage(true);
    back.content.innerHTML = `<div class="cover-design"><p>End.</p></div>`;
    bookEl.appendChild(back.page);

    setTimeout(() => {
        bookInstance = new PageFlip(bookEl, {
            width: pageWidth,
            height: pageHeight,
            size: 'fixed',
            usePortrait: !isLandscape,
            showCover: true,
            maxShadowOpacity: 0.5,
            mobileScrollSupport: true
        });
        bookInstance.loadFromHTML(document.querySelectorAll('.page'));
        loader.style.display = 'none';
    }, 100);
  }
</script>

<style>
  .book-viewport { height: 100vh; width: 100%; background: #1a1a1a; display: flex; justify-content: center; align-items: center; overflow: hidden; }
  .loader { position: absolute; color: white; background: rgba(0,0,0,0.8); padding: 1rem 2rem; border-radius: 4px; z-index: 99; }
  :global(.page) { background-color: #fdfdfd; overflow: hidden; box-shadow: inset 2px 0 10px rgba(0,0,0,0.05); }
  :global(.page-content) { font-size: clamp(16px, 1.5vw, 22px); padding: 40px 30px; height: 100%; box-sizing: border-box; line-height: 1.6; color: #333; text-align: justify; }
  :global(.multi-col) { column-count: 2; column-gap: 2rem; column-rule: 1px solid #eee; display: block; }
  :global(.page-content img) { max-width: 100%; height: auto; margin: 1rem 0; display: block; break-inside: avoid; }
  :global(h1), :global(h2), :global(h3) { break-after: avoid; margin-top: 0; }
  :global(.page.hard) { background: #222; color: #fff; border: 1px solid #333; }
  :global(.cover-design) { height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; }
</style>
