---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// 1. Generate a URL path for every issue found in src/content/issues
export async function getStaticPaths() {
  const issues = await getCollection('issues');
  return issues.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// 2. Get the specific issue data
const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={entry.data.title} description={entry.data.description}>
  <article class="issue-container">
    <header class="issue-header">
      <h1>{entry.data.title}</h1>
      {entry.data.date && <time>{new Date(entry.data.date).toLocaleDateString()}</time>}
    </header>
    
    <div class="issue-content">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .issue-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  .issue-header {
    margin-bottom: 3rem;
    text-align: center;
  }
  .issue-header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }
  .issue-header time {
    color: #888;
    font-size: 0.9rem;
  }
  .issue-content {
    line-height: 1.6;
    font-size: 1.1rem;
  }
</style>
