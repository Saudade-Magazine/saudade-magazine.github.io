---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// ==========================================
// 1. DATA COLLECTION
// ==========================================
export async function getStaticPaths() {
  const allPosts = await getCollection('issues');
  const uniqueIssues = [...new Set(allPosts.map(post => post.slug.split('/')[0]))];

  return uniqueIssues.map(issueId => {
    const issueArticles = allPosts
      .filter(post => post.slug.startsWith(issueId + '/'))
      .sort((a, b) => a.slug.localeCompare(b.slug));

    return {
      params: { slug: issueId },
      props: { issueId, articles: issueArticles },
    };
  });
}

const { issueId, articles } = Astro.props;

// ==========================================
// 2. RENDER CONTENT
// ==========================================
const renderedArticles = await Promise.all(
  articles.map(async (entry) => {
    const { Content } = await entry.render();
    return { params: entry, Content };
  })
);

// ==========================================
// 3. METADATA & IMAGES
// ==========================================
const firstArticle = articles[0];

// FIX: Ensure fallbacks match your file renaming
const frontCover = firstArticle?.data.front_cover || "/img/default-front_cover.jpeg";
const backCover = firstArticle?.data.back_cover || "/img/default-back_cover.jpeg";

const issueTitle = firstArticle?.data.title || "Untitled Issue";
const issueDate = firstArticle?.data.date ? new Date(firstArticle.data.date).toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) : "Current Issue";

const globalCSS = firstArticle?.data.issueGlobalCSS || "";
const allCustomCSS = articles.map(a => a.data.customCSS || "").join("\n");
---

<Layout title={`Issue ${issueId} | ${issueTitle}`}>

  <style set:html={globalCSS + allCustomCSS}></style>

  <style>
    /* ========================================== */
    /* 1. RESET & LAYOUT                          */
    /* ========================================== */
    .book-viewport {
        height: 100vh; width: 100vw; overflow: hidden;
        background-color: #1a1a1a;
        display: flex; justify-content: center; align-items: center;
        font-family: 'Georgia', serif; 
    }

    .container {
        position: relative; width: 100%; height: 100%; 
        /* Outer padding for the viewport */
        padding: 20px; 
        display: flex; justify-content: center; align-items: center;
        box-sizing: border-box;
    }

    .flip-book { display: none; box-shadow: 0 0 30px rgba(0,0,0,0.6); }

    .page { background-color: #fdfdfd; overflow: hidden; position: relative; }
    .page.hard { background-color: #111; border: none; }

    /* ========================================== */
    /* 2. TYPOGRAPHY                              */
    /* ========================================== */
    .page-content {
        font-size: 15px; 
        line-height: 1.6;
        color: #333;
        text-align: justify;
        /* NOTE: Padding is applied via JS to ensure perfect sync */
        height: 100%;
        width: 100%;
        box-sizing: border-box;
        overflow: hidden;
        display: block;

        word-wrap: break-word;
        overflow-wrap: anywhere;
        word-break: break-word;
        hyphens: auto; 
    }

    .page-content h1, .page-content h2, .page-content h3 {
        overflow-wrap: anywhere; 
        word-break: break-word;
        line-height: 1.1; 
        color: #111; 
        font-weight: bold; 
        break-after: avoid; 
        page-break-after: avoid;
    }

    .page-content h1 { font-size: 1.8em !important; margin: 0 0 0.5em 0; border-bottom: 2px solid #111; padding-bottom: 0.2em; }
    .page-content h2 { font-size: 1.4em !important; margin: 1em 0 0.5em 0; }
    .page-content h3 { font-size: 1.2em !important; margin: 1em 0 0.5em 0; }
    
    /* Remove default margins from P tags that might hold images */
    .page-content p { margin: 0 0 1em 0; padding-bottom: 1px; }

    .page-content blockquote {
        margin: 1.5em 0; padding-left: 1em;
        border-left: 3px solid #111;
        font-style: italic; color: #555; background: transparent;
        font-size: 1em;
    }

    /* ========================================== */
    /* 3. STRICT COVER LAYOUT (Flexbox Center)    */
    /* ========================================== */
    .cover-container {
        width: 100%;
        height: 100%;
        background-color: #000; /* Black background for letterboxing */
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center; /* PERFECT CENTERING */
        position: relative;
        overflow: hidden;
    }

    .cover-img-strict {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        object-fit: contain; /* CRITICAL: Never crop, always fit */
        z-index: 1;
        display: block;
    }

    .cover-overlay-strict {
        position: absolute;
        inset: 0;
        z-index: 5;
        background: linear-gradient(to top, rgba(0,0,0,0.8), transparent 60%);
        pointer-events: none;
    }

    .cover-text-layer {
        position: absolute;
        bottom: 0; left: 0; right: 0;
        z-index: 10;
        padding: 40px;
        text-align: center;
        color: white;
        pointer-events: none;
    }
    
    .cover-title { 
        font-size: 3rem; font-weight: 900; 
        text-transform: uppercase; line-height: 1.1; margin: 0;
        text-shadow: 0 4px 15px rgba(0,0,0,0.9); 
    }

    .loader { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: rgba(0,0,0,0.8); color: white; padding: 15px 30px; border-radius: 4px; z-index: 100; }
  </style>

  <div id="raw-source" style="display: none;">
      <div id="meta-front-cover" data-url={frontCover}></div>
      <div id="meta-back-cover" data-url={backCover}></div>
      <div id="meta-title" data-title={issueTitle}></div>
      <div id="meta-date" data-date={issueDate}></div>

      {renderedArticles.map(({ params, Content }) => (
        <div class="chapter-stream">
            <div class="article-content">
                <Content /> 
            </div>
            <hr class="chapter-break" />
        </div>
      ))}
  </div>

  <div class="book-viewport">
      <div class="container">
        <div id="book" class="flip-book"></div>
        <div id="loader" class="loader">Typesetting Issue...</div>
      </div>
  </div>

  <script>
    import { PageFlip } from 'page-flip';

    let bookInstance = null;
    let resizeTimer;
    
    // CONFIG: Define Margin here. This variable controls BOTH CSS and JS Math.
    const PAGE_MARGIN = 60; 

    window.addEventListener('load', () => {
        document.fonts.ready.then(() => initBook());
    });

    window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
            if (bookInstance) {
                bookInstance.destroy();
                document.getElementById('book').innerHTML = '';
                initBook();
            }
        }, 500);
    });

    function initBook() {
        const source = document.getElementById('raw-source');
        const bookEl = document.getElementById('book');
        const loader = document.getElementById('loader');
        loader.style.display = 'block';

        const container = document.querySelector('.container');
        const availW = container.clientWidth;
        const availH = container.clientHeight;
        const isLandscape = availW > availH;

        let pageWidth = isLandscape ? (availW * 0.45) : (availW * 0.95);
        let pageHeight = availH * 0.90;

        if (pageWidth > 600) pageWidth = 600;
        if (pageHeight > 850) pageHeight = 850;

        // 2. CREATE PAGE HELPER
        function createPage(isHard = false, extraClass = "") {
            const page = document.createElement('div');
            page.className = isHard ? `page hard ${extraClass}` : `page ${extraClass}`;
            page.style.width = `${pageWidth}px`;
            page.style.height = `${pageHeight}px`;

            const content = document.createElement('div');
            content.className = 'page-content';
            
            // APPLY PADDING DYNAMICALLY
            // This ensures the visuals match the math exactly.
            content.style.padding = `${PAGE_MARGIN}px`;
            
            page.appendChild(content);
            return { page, content };
        }

        // 3. FRONT COVER (Strict Flexbox Layout)
        const coverUrl = document.getElementById('meta-front-cover').getAttribute('data-url');
        const title = document.getElementById('meta-title').getAttribute('data-title');
        const date = document.getElementById('meta-date').getAttribute('data-date');
        
        const frontCover = createPage(true, 'front-cover');
        // Disable default padding for covers so image can touch edges
        frontCover.page.querySelector('.page-content').style.padding = "0"; 
        
        frontCover.page.innerHTML = `
            <div class="cover-container">
                <img src="${coverUrl}" class="cover-img-strict" />
                <div class="cover-overlay-strict"></div>
                <div class="cover-text-layer">
                    <div style="font-size: 0.8rem; text-transform: uppercase; margin-bottom: 1rem; border-top: 1px solid white; display: inline-block; padding-top: 5px;">${date}</div>
                    <h1 class="cover-title">${title}</h1>
                </div>
            </div>
        `;
        bookEl.appendChild(frontCover.page);

        // 4. TYPESET CONTENT
        const streamNodes = [];
        source.querySelectorAll('.chapter-stream').forEach(chapter => {
            const contentDiv = chapter.querySelector('.article-content');
            Array.from(contentDiv.children).forEach(child => {
                streamNodes.push(child.cloneNode(true));
            });
            const hr = document.createElement('hr');
            hr._isBreak = true;
            streamNodes.push(hr);
        });

        let currPageObj = createPage(false);
        bookEl.appendChild(currPageObj.page);
        
        // CALCULATION: Safe Height = Page Height - (Top Margin + Bottom Margin)
        // We use the exact PAGE_MARGIN variable here.
        const safeHeight = pageHeight - (PAGE_MARGIN * 2);

        for (let i = 0; i < streamNodes.length; i++) {
            let node = streamNodes[i];

            if (node._isBreak) {
                if (currPageObj.content.children.length > 0) {
                    currPageObj = createPage(false);
                    bookEl.appendChild(currPageObj.page);
                }
                continue;
            }

            // --- IMAGE UNWRAPPER & RESIZER ---
            // 1. Detect if image is wrapped in a P tag (Markdown does this)
            if (node.tagName === 'P' && node.querySelector('img')) {
                const img = node.querySelector('img');
                // Extract image, discard the paragraph wrapper
                node = img; 
            }

            // 2. Strict Sizing for Images
            if (node.tagName === 'IMG') {
                node.style.maxHeight = `${safeHeight}px`; // Force it to fit in safe area
                node.style.maxWidth = "100%";
                node.style.width = "auto";
                node.style.height = "auto";
                node.style.margin = "0 auto";
                node.style.display = "block";
                node.style.objectFit = "contain";
            }
            // ---------------------------------

            currPageObj.content.appendChild(node);

            // Check if we exceeded the safe height
            const isOverflowing = currPageObj.content.scrollHeight > safeHeight;

            if (isOverflowing) {
                currPageObj.content.removeChild(node);
                currPageObj = createPage(false);
                bookEl.appendChild(currPageObj.page);
                currPageObj.content.appendChild(node);
            }
        }

        if (currPageObj.content.children.length === 0) {
             bookEl.removeChild(currPageObj.page);
        }

        // 5. BACK COVER (Clean - No Text)
        const endCoverUrl = document.getElementById('meta-back-cover').getAttribute('data-url');
        const backCover = createPage(true, 'back-cover');
        backCover.page.querySelector('.page-content').style.padding = "0";
        
        backCover.page.innerHTML = `
            <div class="cover-container">
                <img src="${endCoverUrl}" class="cover-img-strict" />
                <div class="cover-overlay-strict"></div>
                </div>
        `;
        bookEl.appendChild(backCover.page);

        // 6. INIT LIBRARY
        setTimeout(() => {
            bookInstance = new PageFlip(bookEl, {
                width: pageWidth,
                height: pageHeight,
                size: 'fixed',
                usePortrait: !isLandscape,
                showCover: true,
                maxShadowOpacity: 0.5,
                mobileScrollSupport: true
            });
            bookInstance.loadFromHTML(document.querySelectorAll('.page'));
            bookEl.style.display = 'block';
            loader.style.display = 'none';
        }, 500);
    }
  </script>
</Layout>
