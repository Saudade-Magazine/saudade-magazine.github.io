---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// ==========================================
// 1. DATA COLLECTION
// ==========================================
export async function getStaticPaths() {
  const allPosts = await getCollection('issues');
  const uniqueIssues = [...new Set(allPosts.map(post => post.slug.split('/')[0]))];

  return uniqueIssues.map(issueId => {
    const issueArticles = allPosts
      .filter(post => post.slug.startsWith(issueId + '/'))
      .sort((a, b) => a.slug.localeCompare(b.slug));

    return {
      params: { slug: issueId },
      props: { issueId, articles: issueArticles },
    };
  });
}

const { issueId, articles } = Astro.props;

// ==========================================
// 2. RENDER CONTENT
// ==========================================
const renderedArticles = await Promise.all(
  articles.map(async (entry) => {
    const { Content } = await entry.render();
    return { params: entry, Content };
  })
);

// ==========================================
// 3. METADATA & DEFAULTS
// ==========================================
const firstArticle = articles[0];
const coverImage = firstArticle?.data.cover || firstArticle?.data.thumbnail || "/img/default-cover.jpeg";
const endCoverImage = firstArticle?.data.end_cover || "/img/default-back.jpeg";
const issueTitle = firstArticle?.data.title || "Untitled Issue";

// We keep custom CSS support if you still want to inject it
const globalCSS = firstArticle?.data.issueGlobalCSS || "";
const allCustomCSS = articles.map(a => a.data.customCSS || "").join("\n");
---

<Layout title={`Issue ${issueId} | ${issueTitle}`}>

  <style set:html={globalCSS + allCustomCSS}></style>

  <style>
    /* ========================================== */
    /* 1. RESET & LAYOUT (No Tailwind Dependency) */
    /* ========================================== */
    
    /* The Stage */
    .book-viewport {
        height: 100vh;
        width: 100vw;
        overflow: hidden;
        background-color: #1a1a1a;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: 'Georgia', serif; /* Enforce Serif for Book feel */
    }

    .container {
        position: relative;
        width: 100%;
        height: 100%;
        padding: 20px;
        display: flex;
        justify-content: center;
        align-items: center;
        box-sizing: border-box;
    }

    /* The Book Itself */
    .flip-book {
        display: none; /* Hidden until loaded */
        box-shadow: 0 0 30px rgba(0,0,0,0.6);
    }

    /* ========================================== */
    /* 2. PAGE STYLING (Strict Print Rules)       */
    /* ========================================== */
    .page {
        background-color: #fdfdfd;
        overflow: hidden;
        position: relative;
    }

    .page.hard {
        background-color: #111;
        border: none;
    }

    /* TYPOGRAPHY */
    .page-content {
        /* Fluid Font: Minimum 14px, Ideal 1.2vw, Max 18px */
        font-size: clamp(14px, 1.2vw, 18px);
        line-height: 1.6;
        color: #333;
        text-align: justify;
        
        /* SAFE AREA: 40px Top/Bottom, 30px Sides */
        padding: 40px 30px; 
        height: 100%;
        box-sizing: border-box;
    }

    /* FORCE RESET: Override any global CSS that might leak in */
    .page-content p { margin: 0 0 1em 0; text-indent: 0; }
    .page-content h1, .page-content h2, .page-content h3 { line-height: 1.2; margin: 1em 0 0.5em 0; color: #111; font-weight: bold; }
    .page-content h1 { font-size: 2.2em; border-bottom: 2px solid #111; padding-bottom: 0.2em; }
    .page-content h2 { font-size: 1.6em; }
    .page-content ul, .page-content ol { margin: 0 0 1em 1.5em; padding: 0; }
    .page-content li { margin-bottom: 0.5em; }

    /* BLOCKQUOTES (Fixed) */
    .page-content blockquote {
        margin: 1.5em 0;
        padding-left: 1em;
        border-left: 4px solid #111;
        font-style: italic;
        color: #555;
        background: transparent;
    }

    /* IMAGES (Strict Containment) */
    .page-content img {
        display: block;
        max-width: 100%;
        /* Cap height at 60% of page to ensure text room */
        max-height: 60%; 
        width: auto;
        height: auto;
        margin: 1.5em auto;
        object-fit: contain;
    }

    /* ========================================== */
    /* 3. COVER DESIGN (Replaces Tailwind Classes)*/
    /* ========================================== */
    .cover-img {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        object-fit: cover;
        z-index: 0;
    }

    .cover-overlay {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        z-index: 10;
        /* Gradient Fade for Text Readability */
        background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.4) 40%, transparent 100%);
    }

    .cover-content {
        position: absolute;
        bottom: 0; left: 0; width: 100%;
        padding: 3rem;
        box-sizing: border-box;
        z-index: 20;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
    }

    .cover-title {
        color: white;
        font-family: 'Times New Roman', serif;
        font-size: 3.5rem; /* Big Title */
        font-weight: 900;
        text-transform: uppercase;
        line-height: 1;
        margin: 0;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.8);
    }

    .cover-subtitle {
        color: #ddd;
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-top: 1rem;
        border-top: 1px solid #777;
        padding-top: 1rem;
        display: inline-block;
    }

    /* END COVER SPECIFICS */
    .end-text {
        color: white;
        text-transform: uppercase;
        letter-spacing: 0.3em;
        font-size: 0.9rem;
        border-top: 1px solid #555;
        border-bottom: 1px solid #555;
        padding: 10px 20px;
    }

    /* LOADER */
    .loader {
        position: absolute;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        background: rgba(0,0,0,0.8);
        color: white;
        padding: 15px 30px;
        font-family: monospace;
        border-radius: 4px;
        z-index: 100;
    }
  </style>

  <div id="raw-source" style="display: none;">
      <div id="meta-cover" data-cover={coverImage}></div>
      <div id="meta-end-cover" data-cover={endCoverImage}></div>
      <div id="meta-title" data-title={issueTitle}></div>

      {renderedArticles.map(({ params, Content }) => (
        <div class="chapter-stream">
            <div class="article-content">
                <Content /> 
            </div>
            <hr class="chapter-break" />
        </div>
      ))}
  </div>

  <div class="book-viewport">
      <div class="container">
        <div id="book" class="flip-book"></div>
        <div id="loader" class="loader">Typesetting Issue...</div>
      </div>
  </div>

  <script>
    import { PageFlip } from 'page-flip';

    let bookInstance = null;
    let resizeTimer;
    
    // CONFIG: Width (px) before we split text into 2 columns
    const CONFIG = { multiColumnThreshold: 500 };

    window.addEventListener('load', () => {
        document.fonts.ready.then(() => initBook());
    });

    window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
            if (bookInstance) {
                bookInstance.destroy();
                document.getElementById('book').innerHTML = '';
                initBook();
            }
        }, 500);
    });

    function initBook() {
        const source = document.getElementById('raw-source');
        const bookEl = document.getElementById('book');
        const loader = document.getElementById('loader');
        loader.style.display = 'block';

        // 1. CALCULATE DIMENSIONS
        const container = document.querySelector('.container');
        const availW = container.clientWidth;
        const availH = container.clientHeight;
        const isLandscape = availW > availH;

        let pageWidth = isLandscape ? (availW * 0.45) : (availW * 0.95);
        let pageHeight = availH * 0.90;

        // Cap max sizes for desktop readability
        if (pageWidth > 600) pageWidth = 600;
        if (pageHeight > 850) pageHeight = 850;

        const useMultiColumn = pageWidth > CONFIG.multiColumnThreshold;

        // 2. PAGE FACTORY
        function createPage(isHard = false, extraClass = "") {
            const page = document.createElement('div');
            page.className = isHard ? `page hard ${extraClass}` : `page ${extraClass}`;
            page.style.width = `${pageWidth}px`;
            page.style.height = `${pageHeight}px`;

            const content = document.createElement('div');
            content.className = 'page-content';
            
            // Standard CSS Columns (No Tailwind)
            if (useMultiColumn && !isHard) {
                content.style.columnCount = "2";
                content.style.columnGap = "2rem";
                content.style.columnRule = "1px solid #eee";
            }
            
            page.appendChild(content);
            return { page, content };
        }

        // 3. GENERATE FRONT COVER
        const coverUrl = document.getElementById('meta-cover').getAttribute('data-cover');
        const title = document.getElementById('meta-title').getAttribute('data-title');
        
        const frontCover = createPage(true, 'front-cover');
        frontCover.page.innerHTML = `
            <img src="${coverUrl}" class="cover-img" alt="Cover" />
            <div class="cover-overlay"></div>
            <div class="cover-content">
                <h1 class="cover-title">${title}</h1>
                <div class="cover-subtitle">Issue Preview</div>
            </div>
        `;
        bookEl.appendChild(frontCover.page);

        // 4. TYPESET CONTENT
        const streamNodes = [];
        source.querySelectorAll('.chapter-stream').forEach(chapter => {
            const contentDiv = chapter.querySelector('.article-content');
            Array.from(contentDiv.children).forEach(child => {
                streamNodes.push(child.cloneNode(true));
            });
            const hr = document.createElement('hr');
            hr._isBreak = true;
            streamNodes.push(hr);
        });

        let currPageObj = createPage(false);
        bookEl.appendChild(currPageObj.page);
        
        // SAFE HEIGHT: Height - Padding (80px) - Buffer (20px)
        const safeHeight = pageHeight - 100;

        for (let i = 0; i < streamNodes.length; i++) {
            const node = streamNodes[i];

            // A. Manual Page Breaks
            if (node._isBreak) {
                if (currPageObj.content.children.length > 0) {
                    currPageObj = createPage(false);
                    bookEl.appendChild(currPageObj.page);
                }
                continue;
            }

            // B. Smart Image Sizing
            const isImage = node.tagName === 'IMG' || node.querySelector('img');
            if (isImage) {
                const img = node.tagName === 'IMG' ? node : node.querySelector('img');
                
                // Pure CSS enforcement
                img.style.maxWidth = "100%";
                img.style.maxHeight = `${safeHeight * 0.6}px`; // Cap at 60%
                img.style.width = "auto";
                img.style.height = "auto";
                img.style.objectFit = "contain";
                img.style.display = "block";
                img.style.margin = "1em auto";
                
                // Clean up paragraph wrappers
                if (node.tagName === 'P') { 
                    node.style.margin = "0"; 
                    node.style.padding = "0";
                }
            }

            // C. Append & Measure
            currPageObj.content.appendChild(node);

            // D. Overflow Logic
            let isOverflowing = false;
            if (useMultiColumn) {
                isOverflowing = currPageObj.content.scrollWidth > currPageObj.content.clientWidth + 20;
            } else {
                isOverflowing = currPageObj.content.scrollHeight > safeHeight;
            }

            if (isOverflowing) {
                currPageObj.content.removeChild(node);
                currPageObj = createPage(false);
                bookEl.appendChild(currPageObj.page);
                currPageObj.content.appendChild(node);
            }
        }

        // Remove empty last page
        if (currPageObj.content.children.length === 0) {
             bookEl.removeChild(currPageObj.page);
        }

        // 5. GENERATE BACK COVER
        const endCoverUrl = document.getElementById('meta-end-cover').getAttribute('data-cover');
        const backCover = createPage(true, 'back-cover');
        backCover.page.innerHTML = `
             <img src="${endCoverUrl}" class="cover-img" style="opacity: 0.3;" />
             <div class="cover-overlay" style="display: flex; align-items: center; justify-content: center;">
                <div class="end-text">End of Issue</div>
             </div>
        `;
        bookEl.appendChild(backCover.page);

        // 6. INITIALIZE FLIPBOOK
        setTimeout(() => {
            bookInstance = new PageFlip(bookEl, {
                width: pageWidth,
                height: pageHeight,
                size: 'fixed',
                usePortrait: !isLandscape,
                showCover: true,
                maxShadowOpacity: 0.5,
                mobileScrollSupport: true
            });
            bookInstance.loadFromHTML(document.querySelectorAll('.page'));
            
            bookEl.style.display = 'block';
            loader.style.display = 'none';
        }, 100);
    }
  </script>
</Layout>
