---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

// Fetch all collections
const allPages = await getCollection('pages');
const allIssues = await getCollection('issues');

// Combine for filtering out Drafts
const allContent = [...allPages, ...allIssues];

// Filter for pagetype containing 'main', sort by number, AND hide drafts
const posts = allContent.filter(item => {
    // 1. Check if it has the 'main' tag (Theme Requirement)
    const isMain = item.data.pagetype && item.data.pagetype.includes('main');

    // 2. Check if it is a draft (Our New Feature)
    const isVisible = import.meta.env.PROD ? item.data.draft !== true : true;

    // Only return items that pass BOTH checks
    return isMain && isVisible;
}).sort((a, b) => {
    const numA = a.data.number || 9999;
    const numB = b.data.number || 9999;
    return numA - numB;
});

// Get index-page metadata (from pages collection)
const indexPage = allPages.find(p => p.slug === 'index');

// 3. UPDATED: Default title is now 'Saudade Magazine'
const title = indexPage?.data.title || 'Saudade Magazine';
const description = indexPage?.data.description;

let postCounter = 0;
---

<Layout title={title} description={description}>
  <main class="flex flex-col gap-20">
    {
      posts.map((post) => {
        postCounter++;
        return (
          <PostCard
            post={post}
            reverse={postCounter % 2 === 0}
            priority={postCounter <= 2}
          />
        );
      })
    }
  </main>
</Layout>
